<view class="task-card card {{task.completed ? 'completed' : ''}}" bindtap="onTap" bindlongpress="onSwipeLeft">
  <view class="card-left">
    <view class="circle {{task.completed ? 'circle-done' : 'circle-empty'}}" catchtap="onCircleTap">
      <text wx:if="{{task.completed}}" class="circle-check">✓</text>
    </view>
  </view>
  <view class="card-body">
    <view class="task-name">{{task.name}}</view>
    <view class="task-info">
      <text class="task-time">{{task.start_time}} - {{task.end_time}}</text>
      <text class="task-duration">{{task.duration}}分钟</text>
    </view>
  </view>
  <view class="card-right">
    <view class="priority-dot priority-{{task.priority}}"></view>
  </view>
</view>
