<view wx:if="{{loading}}" class="stats-loading">
  <text>加载中...</text>
</view>
<view wx:else class="stats-grid">
  <view class="stat-card stat-blue">
    <text class="stat-num">{{stats.totalTasks}}</text>
    <text class="stat-label">本周任务总数</text>
  </view>
  <view class="stat-card stat-green">
    <text class="stat-num">{{stats.completionRate}}%</text>
    <text class="stat-label">完成率</text>
  </view>
  <view class="stat-card stat-purple">
    <text class="stat-num">{{stats.habitQualified}}</text>
    <text class="stat-label">习惯达标</text>
  </view>
  <view class="stat-card stat-orange">
    <text class="stat-num">{{stats.completedTasks}}</text>
    <text class="stat-label">已完成任务</text>
  </view>
</view>
