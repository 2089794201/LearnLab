page {
  --color-primary: #14b8a6;
  --color-primary-hover: #0d9488;
  --color-primary-light: #2dd4bf;
  --color-primary-bg: rgba(20, 184, 166, 0.12);
  --color-bg: #080c0c;
  --color-surface: #111818;
  --color-surface-hover: #182020;
  --color-border: #1e2a2a;
  --color-border-emphasis: #2a3a3a;
  --color-text-primary: #e8f0f0;
  --color-text-secondary: #7a8a8a;
  --color-text-tertiary: #4a5a5a;
  --color-white: #ffffff;
  --color-success: #22c55e;
  --color-danger: #ef4444;
  --color-priority-high: #f87171;
  --color-priority-medium: #fbbf24;
  --color-priority-low: #4ade80;
  --color-modal-overlay: rgba(0, 0, 0, 0.7);
  --shadow-card: 0 1px 4px rgba(0, 0, 0, 0.04);
  --shadow-modal: 0 4px 16px rgba(0, 0, 0, 0.08);
  --shadow-toast: 0 8px 24px rgba(0, 0, 0, 0.12);
  --radius-sm: 8rpx;
  --radius-md: 14rpx;
  --radius-lg: 18rpx;
  --radius-full: 9999rpx;
  --spacing-xs: 8rpx;
  --spacing-sm: 12rpx;
  --spacing-md: 16rpx;
  --spacing-lg: 24rpx;
  --spacing-xl: 32rpx;
  --spacing-xxl: 48rpx;
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 38rpx;
  --font-xxl: 48rpx;

  background-color: var(--color-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: var(--font-md);
  color: var(--color-text-primary);
  line-height: 1.5;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.theme-light {
  --color-primary: #0d9488;
  --color-primary-hover: #0f766e;
  --color-primary-light: #14b8a6;
  --color-primary-bg: rgba(13, 148, 136, 0.08);
  --color-bg: #f0f4f4;
  --color-surface: #ffffff;
  --color-surface-hover: #f5f8f8;
  --color-border: #dde4e4;
  --color-border-emphasis: #c5d0d0;
  --color-text-primary: #0f1a1a;
  --color-text-secondary: #5a6a6a;
  --color-text-tertiary: #9aaaaa;
  --color-success: #16a34a;
  --color-danger: #dc2626;
  --color-priority-high: #ef4444;
  --color-priority-medium: #f59e0b;
  --color-priority-low: #22c55e;
  --color-modal-overlay: rgba(0, 0, 0, 0.5);
  --shadow-card: 0 1px 4px rgba(0, 0, 0, 0.04);
  --shadow-modal: 0 4px 16px rgba(0, 0, 0, 0.08);
  --shadow-toast: 0 8px 24px rgba(0, 0, 0, 0.12);
}

@media (prefers-reduced-motion: reduce) {
  page {
    transition: none;
  }
  .theme-light {
    transition: none;
  }
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-card);
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-modal-overlay);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: fadeIn 0.2s ease-out;
}

.modal-content {
  background: var(--color-surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  width: 100%;
  max-height: 80vh;
  padding: var(--spacing-xl);
  overflow-y: auto;
  animation: slideUp 0.2s ease-out;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.modal-title {
  color: var(--color-text-primary);
  font-size: var(--font-lg);
  font-weight: 600;
}

.modal-close {
  color: var(--color-text-secondary);
  font-size: var(--font-xl);
  padding: var(--spacing-xs);
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-white);
  border-radius: var(--radius-sm);
  padding: var(--spacing-sm) var(--spacing-xl);
  font-size: var(--font-md);
  text-align: center;
  border: none;
  transition: opacity 0.1s ease;
}

.btn-primary:active {
  opacity: 0.85;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--color-primary);
  color: var(--color-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  box-shadow: 0 4px 12px rgba(20, 184, 166, 0.4);
  z-index: 100;
  transition: opacity 0.1s ease, transform 0.1s ease;
}

.fab:active {
  opacity: 0.85;
  transform: scale(0.95);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--color-text-secondary);
}

.empty-state-icon {
  font-size: 64rpx;
  margin-bottom: var(--spacing-md);
  opacity: 0.3;
}

.empty-state-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

.form-group {
  margin-bottom: var(--spacing-md);
}

.form-label {
  color: var(--color-text-tertiary);
  font-size: var(--font-sm);
  margin-bottom: var(--spacing-xs);
}

.form-input {
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  padding: var(--spacing-sm);
  font-size: var(--font-md);
  color: var(--color-text-primary);
  border: 1px solid var(--color-border);
  transition: border-color 0.2s ease;
}

.form-input:focus {
  border-color: var(--color-primary);
}

.form-error {
  color: var(--color-danger);
  font-size: var(--font-sm);
  margin-top: 4rpx;
}

.page-container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
  background-color: var(--color-bg);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-enter {
  animation: fadeInUp 0.2s ease-out both;
}
