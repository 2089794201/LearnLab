<view class="page-container">
  <view class="user-section card">
    <open-data type="userAvatarUrl" class="user-avatar" />
    <open-data type="userNickName" class="user-name" />
  </view>

  <view class="section-title">本周统计</view>
  <stats-cards stats="{{stats}}" loading="{{loading}}" />

  <view class="menu-section card">
    <view class="menu-item" bindtap="onExport">
      <text>数据导出</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onSettings">
      <text>设置</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <text>关于</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item menu-item-danger" bindtap="onLogout">
      <text>退出登录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{showAbout}}" class="modal-overlay" bindtap="onAboutClose">
    <view class="modal-content" catchtap="onModalStop">
      <view class="modal-header">
        <text class="modal-title">关于 LearnLab</text>
        <text class="modal-close" bindtap="onAboutClose">✕</text>
      </view>
      <view class="about-body">
        <text class="about-name">LearnLab</text>
        <text class="about-version">版本 1.0</text>
        <text class="about-desc">每日学习计划 + 习惯养成工具</text>
      </view>
    </view>
  </view>
</view>
